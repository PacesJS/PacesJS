{
  "name": "pacesjs",
  "private": true,
  "version": "0.0.0",
  "description": "paces: a JavaScript execution profiler that is easy to read",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "coverage": "node scripts/coverage.mjs",
    "test:e2e": "pnpm build && playwright test && pnpm --filter @pacesjs/ui test:e2e",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && pnpm check:boundaries",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench:browser": "node scripts/bench-browser.mjs",
    "fixtures:browser": "pnpm --filter @pacesjs/collector-browser build && node scripts/gen-browser-fixtures.mjs",
    "fixtures": "pnpm --filter @pacesjs/collector-node build && node scripts/gen-fixtures.mjs",
    "test:visual": "pnpm build && playwright test -c e2e/ui/visual/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
