  },
  "dependencies": {
    "@pacesjs/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
