{
  "name": "@pacesjs/collector-node",
  "version": "0.0.0",
  "description": "paces Node collector: preload scripts, socket client, flush logic. Node built-ins only.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preload.cjs": "./dist/preload.cjs",
